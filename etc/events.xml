<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Re-validate the delivery date (it may have passed the cut-off since
         the shopper picked it) and copy the fields onto the order. Throwing
         here aborts placement with the message shown to the shopper. -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="magenx_checkout_fields_copy_to_order"
                  instance="Magenx\CheckoutFieldsGraphQl\Observer\CopyCheckoutFieldsToOrder"/>
    </event>
    <!-- Expose the values to the order confirmation email template. -->
    <event name="email_order_set_template_vars_before">
        <observer name="magenx_checkout_fields_email_vars"
                  instance="Magenx\CheckoutFieldsGraphQl\Observer\AddOrderEmailVariables"/>
    </event>
</config>
